# UrbanPulse Server Environment Configuration

# Server Port
PORT=5000

# Environment Mode (development, production, test)
NODE_ENV=development

# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (required)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# Optional: comma-separated DNS server IPs to override OS defaults (e.g. for Atlas SRV resolution)
# Leave empty to use the system's default DNS configuration.
# Example: DNS_SERVERS=8.8.8.8,8.8.4.4
DNS_SERVERS=
